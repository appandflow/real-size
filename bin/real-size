#!/bin/sh
true /*
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=${self%/*}/$link ;;
  esac
done
dir=${self%/*}
[ "$dir" = "$self" ] && dir=.
case $(uname -sm) in
  "Darwin arm64") target=darwin-arm64 ;;
  "Darwin x86_64") target=darwin-x64 ;;
  "Linux x86_64" | "Linux amd64") target=linux-x64 ;;
  "Linux aarch64" | "Linux arm64") target=linux-arm64 ;;
  *) target= ;;
esac
binary=$dir/../prebuilds/$target/real-size
if [ -z "$target" ] || [ ! -x "$binary" ]; then
  echo "real-size: no prebuilt binary for $(uname -sm)" >&2
  exit 2
fi
exec "$binary" "$@"
: <<'//'
*/
const { spawnSync } = process.getBuiltinModule("node:child_process");
const { existsSync, realpathSync } = process.getBuiltinModule("node:fs");
const { dirname, join } = process.getBuiltinModule("node:path");
const target = `${process.platform}-${process.arch}`;
const name = process.platform === "win32" ? "real-size.exe" : "real-size";
const binary = join(dirname(realpathSync(process.argv[1])), "..", "prebuilds", target, name);
if (!existsSync(binary)) {
  console.error(`real-size: no prebuilt binary for ${target}`);
  process.exit(2);
}
const result = spawnSync(binary, process.argv.slice(2), { stdio: "inherit" });
if (result.error) {
  console.error(`real-size: ${result.error.message}`);
  process.exit(2);
}
if (result.signal) process.kill(process.pid, result.signal);
process.exit(result.status ?? 1);
//
